{
  "name": "betby-scout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Analytics for BETBY-powered sportsbooks. Ingests the public bets feed and odds the logged-in browser already receives, then ranks candidate edges. Never places bets.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n server,dash,collect -c blue,magenta,green \"npm:dev:server\" \"npm:dev:dashboard\" \"npm:dev:collector\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:dashboard": "vite --config vite.dashboard.config.ts",
    "dev:collector": "node scripts/build-collector.mjs --watch",
    "build": "npm run build:collector && npm run build:dashboard && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:dashboard": "vite build --config vite.dashboard.config.ts",
    "build:collector": "node scripts/build-collector.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"tests/*.test.ts\"",
    "ext": "node scripts/build-collector.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
