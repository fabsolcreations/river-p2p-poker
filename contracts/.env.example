# Copy to contracts/.env and fill in before running anything against
# baseSepolia or base (never needed for local `npx hardhat test`/`node`).
#
# This is the DEPLOYER/OWNER key (runs deploy.ts, can later call
# setOperator/pause/unpause) - keep it separate from the operator hot key
# the running app holds (that one lives in the app's own .dev.vars, see
# .dev.vars.example at the repo root). Never commit a real value here.
DEPLOYER_PRIVATE_KEY=

BASE_SEPOLIA_RPC_URL=
BASE_MAINNET_RPC_URL=
