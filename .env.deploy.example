# Deploy-time configuration for Cloudflare. Copy to `.env.deploy` and fill in.
# Only needed when deploying - local dev ignores all of this and keeps using
# Miniflare's local database.
#
#   npm run cf:d1:create   # once, creates the database and prints its id
#   npm run cf:schema      # applies drizzle/*.sql to the real database
#   npm run cf:deploy      # preflight + build + deploy

# From `npm run cf:d1:create`. Binding name stays DB (see .openai/hosting.json);
# only the database's real name and id belong here.
CF_D1_DATABASE_NAME=river-playriver
CF_D1_DATABASE_ID=

# NOTE: OPERATOR_PRIVATE_KEY does NOT go here. It's a Worker secret, set with
# `wrangler secret put OPERATOR_PRIVATE_KEY`, and only ever for a network you
# actually intend to move value on. Without it set, withdrawals return a clean
# "not configured" response instead of half-working - which is the correct
# state for a test-chips deployment.

# Custom domains to bind the Worker to, comma-separated. Cloudflare creates
# the DNS records for these itself - don't add A/CNAME records by hand.
# The zone must already be active in the same Cloudflare account.
CF_CUSTOM_DOMAINS=playriver.gg,www.playriver.gg
